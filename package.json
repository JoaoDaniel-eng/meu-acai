{
  "name": "acai-da-roca",
  "version": "1.0.0",
  "private": true,
  "description": "Site de pedidos e painel administrativo do Açaí da Roça",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"public/js/**/*.js\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"public/js/**/*.js\" eslint.config.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  }
}
